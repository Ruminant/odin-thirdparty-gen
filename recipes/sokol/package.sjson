name = "sokol"
version = "vendored"
source_notes = "Sokol C sources and generated Odin bindings are vendored. Dear ImGui is pinned through build.zig.zon and compiled by the Zig build graph with the matching vendored dear_bindings output."
sokol_source_dir = "source/c"
imgui_version = "1.92.8-docking"
imgui_url = "https://github.com/ocornut/imgui/archive/refs/tags/v1.92.8-docking.tar.gz"
emscripten_version = "6.0.2"
odin_output_dir = "../../odin/sokol"
example_output_dir = "../../examples/sokol"
package_name = "sokol"

handwritten = []
license_files = [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
]

recipe_license_files = [
    "dcimgui/LICENSE-dear_bindings.txt",
]

windows_amd64_lib_dir = "../../odin/sokol/libs/windows/amd64"
windows_artifacts = [
    "*.lib",
    "*.dll",
]
